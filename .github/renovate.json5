{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  // allow sync_lockfile workflow to run without blocking renovate
  "gitIgnoredAuthors": [
    "github-actions[bot]+sync-lockfile@users.noreply.github.com"
  ],
  "timezone": "Asia/Tokyo",
  // allow to run on non-office hours every day.
  // note that it is NOT the schedule of renovate task dispatching,
  //  but the time window of allowing renovate to create PRs,
  //  see https://docs.renovatebot.com/configuration-options/#schedule
  "schedule": [ "* 20-23,0-8 * * 1-5", "* * * * 0,6" ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "enabledManagers": [
    "pep621",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "rangeStrategy": "widen"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions updates"
    },
    // do not update Python version used for building whl
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": ["python"],
      "enabled": false
    }
  ],
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security",
      "dependencies"
    ],
    // The default "update-lockfile" strategy only touches uv.lock when the
    // fixed version already satisfies the range in pyproject.toml. Renovate
    // rebuilds such lockfile-only branches from scratch on every run, so the
    // requirements.txt commit pushed by the sync_lockfile workflow gets
    // force-pushed away and the two bots loop forever (#870, #998, #1082).
    // "bump" raises the lower bound in pyproject.toml instead, which takes the
    // normal update path that leaves the sync_lockfile commit alone.
    "rangeStrategy": "bump",
    "gitIgnoredAuthors": [
      "github-actions[bot]+sync-lockfile",
      "github-actions[bot]+sync-lockfile@users.noreply.github.com"
    ]
  },
  "prHourlyLimit": 16
}
